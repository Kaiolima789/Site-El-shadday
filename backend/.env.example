PORT=3000
ADMIN_PASSWORD=replace-with-a-long-unique-secret
ALLOWED_ORIGINS=https://site-el-shadday.vercel.app
# In production, set this to a file path inside the Render persistent disk mount.
DATABASE_PATH=./elshadday.db
# Leave DATABASE_URL unset for local SQLite.
# Supabase: use the Session pooler URL from Project > Connect (keep sslmode=require).
# DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
# Set these only when importing an SQLite backup into an empty PostgreSQL database.
# DATABASE_SOURCE_PATH=./elshadday.db
# CONFIRM_POSTGRES_IMPORT=YES
